# JANVISTA AI - Environment Configuration Example

# Google Gemini API Key (Optional: system uses local fallback if unconfigured)
GEMINI_API_KEY=""

# Google Maps Platform Key (Optional: system uses local SVG/GeoJSON India map fallback if unconfigured)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_VERSION="1.0.0"
